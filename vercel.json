{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install && cd frontend && npm install",
  "buildCommand": "npm run build && cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://extengen-backend.onrender.com/health"
    },
    {
      "source": "/openapi.json",
      "destination": "https://extengen-backend.onrender.com/openapi.json"
    },
    {
      "source": "/sse",
      "destination": "https://extengen-backend.onrender.com/sse"
    },
    {
      "source": "/messages",
      "destination": "https://extengen-backend.onrender.com/messages"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://extengen-backend.onrender.com/api/$1"
    },
    {
      "source": "/((?!api/|health|openapi.json|sse|messages).*)",
      "destination": "/index.html"
    }
  ]
}
