{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://extengen-backend.onrender.com/health"
    },
    {
      "source": "/openapi.json",
      "destination": "https://extengen-backend.onrender.com/openapi.json"
    },
    {
      "source": "/sse",
      "destination": "https://extengen-backend.onrender.com/sse"
    },
    {
      "source": "/messages",
      "destination": "https://extengen-backend.onrender.com/messages"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://extengen-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
