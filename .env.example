# ExtenGen Environment Variables

# Node & Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL with pgvector / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/extengen
# Or Supabase connection string (use IPv4 pooler, URL-encode special characters like @ as %40 in password):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Docker Compose PostgreSQL credentials and published ports
POSTGRES_DB=extengen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-for-local-docker-only
POSTGRES_PORT=5434
EXTENGEN_PORT=3001

# Supabase Auth / Direct configuration (optional, for direct Supabase Auth integration)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Generative AI — FREE embeddings via text-embedding-004 (768 dims)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
GEMINI_SUMMARY_MODEL=gemini-2.5-flash

# Redis / BullMQ for Async Embedding Queue
# If left empty, ExtenGen runs queue jobs synchronously in-process
REDIS_URL=redis://localhost:6379

# GitHub Integration (Optional, for GitHub ingestion)
GITHUB_TOKEN=
# Required to accept POST /api/v1/webhooks/github events
GITHUB_WEBHOOK_SECRET=

# Default Org and User for Stdio MCP Mode (Claude Code / single-tenant local agent)
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000002
